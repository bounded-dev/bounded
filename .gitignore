node_modules/
.agent-state/

# Per-checkout state (ADR 2026-014): git worktrees of this repository and
# Claude Code's local state
.worktrees/
.claude/worktrees/
.claude/settings.local.json
.DS_Store
*.log

# What an older checkout may still hold at its root from the legacy harness
# (ADR 2026-014): its runtime state and its old package build output; ignored
# so it is never committed
/agent/
/auth.json
/sessions/
/models-store.json
/bin/
/missions/
/run-history.jsonl
/docs/dogfood/.rendered-*

# The bounded package's bundled CLI, built by its prepack (ADR 2026-016)
dist/

# bounded's package catalogue, generated by its prepack (bounded catalog build, ADR 2026-029)
src/bounded.catalog.json
# and each published pack's package's catalogue, generated by its prepack (ADR 2026-030)
src/published-packs/*/bounded.catalog.json

# What Claude Code writes into the prereqs status band's folder each time it loads it
# (ADR 2026-027): its declarations and the tsconfig that reads them
src/hosts/claude-code/prereqs-status-band/.claude-plugin/types/
src/hosts/claude-code/prereqs-status-band/tsconfig.json
