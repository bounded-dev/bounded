{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["extensions/**/*.ts", "hosts/**/*.ts", "packs/**/*.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["extensions/orca-*.ts", "packs/ts/scripts/testdata", "packs/*/reference"]
}
