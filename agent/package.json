{
  "name": "bounded",
  "version": "2.0.1",
  "description": "The Bounded Harness — a coding-agent harness: extensions, skills, packs, and gates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounded-dev/the-bounded-harness.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/bounded-dev/the-bounded-harness#readme",
  "bugs": {
    "url": "https://github.com/bounded-dev/the-bounded-harness/issues"
  },
  "type": "module",
  "bin": {
    "bounded": "scripts/bounded"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "agents/",
    "hosts/",
    "packs/",
    "scripts/bounded",
    "scripts/bounded-change-run",
    "scripts/bounded-gates",
    "scripts/bounded-handoff",
    "scripts/bounded-ticket",
    "scripts/print-version.mjs",
    "skills/",
    "src/",
    "dist/",
    "tsconfig.json",
    "installer-lock.json",
    "build-info.json",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/testdata/**"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./hosts/pi/extensions",
      "./extensions"
    ]
  },
  "scripts": {
    "build:dist": "node scripts/build-distribution.mjs",
    "prepack": "npm run build:dist",
    "publish:local": "node scripts/publish-local.mjs",
    "check": "tsc --noEmit && npm run test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@testcontainers/postgresql": "12.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/rule-tester": "8.68.0",
    "@typescript-eslint/utils": "8.68.0",
    "@vitejs/plugin-react": "6.1.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "ts-morph": "28.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.8.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "zod": "4.6.4"
  },
  "dependencies": {
    "picomatch": "4.0.7"
  }
}
