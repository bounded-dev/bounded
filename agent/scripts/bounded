#!/usr/bin/env bash
# bounded — the Bounded Harness CLI. One command, subcommands for everything:
#
#   bounded init                    # initialize an empty project
#   bounded --version               # show the exact installed build
#   bounded gates <gate> [dir]      # run one artifact gate (bounded gates --list)
#   bounded handoff check <receipt.json> <producer-ref>
#   bounded ticket                  # start a session bound to the ARCHITECT role
#   bounded change-run [dir]        # open the boundary for a change run
#   bounded lead prepare [--new] [ticket-number] # select a ticket run
#   bounded adopt [--cwd dir]       # adopt an existing project
#   bounded change-diff [--cwd dir] # compare a project change
#
# Each subcommand is its own script beside this one; this file only routes.
# The vision (TN-26-007): install the bounded CLI, type `bounded init`, and
# the harness wires itself into every agent framework it supports.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPTS="$(cd -P "$(dirname "$SOURCE")" && pwd)"

usage() {
  sed -n '2,13p' "$SCRIPTS/bounded" | sed 's/^# \{0,1\}//'
}

SUB="${1:-}"
if [[ "$SCRIPTS" == *"/node_modules/"* ]]; then
  case "$SUB" in
    init) shift; exec node "$SCRIPTS/../dist/src/project-init-cli.js" "$@" ;;
    --version|-V) exec node "$SCRIPTS/print-version.mjs" ;;
    -h|--help|help|"")
      printf '%s\n' 'bounded — initialize a project with its own harness' \
        '  bounded init                 guide an agent through product discovery' \
        '  bounded init --interactive   plan and apply in a terminal' \
        '  bounded --version            show the installed build'
      exit 0 ;;
    *) echo "bounded: the installed CLI initializes projects; run project commands through .bounded/harness/scripts/bounded" >&2; exit 64 ;;
  esac
fi
case "$SUB" in
  init)            shift; exec node "$SCRIPTS/../src/project-init-cli.ts" "$@" ;;
  --version|-V)    exec node "$SCRIPTS/print-version.mjs" ;;
  compose)         shift; exec node "$SCRIPTS/../packs/compose.ts" "$@" ;;
  adopt|change-diff|capture-baseline) shift; exec node "$SCRIPTS/../packs/command.ts" "$SUB" "$@" ;;
  gates)           shift; exec "$SCRIPTS/bounded-gates" "$@" ;;
  handoff)         shift; exec "$SCRIPTS/bounded-handoff" "$@" ;;
  ticket)          shift; exec "$SCRIPTS/bounded-ticket" "$@" ;;
  change-run)      shift; exec "$SCRIPTS/bounded-change-run" "$@" ;;
  lead)            shift; exec node "$SCRIPTS/../src/lead-cli.ts" "$@" ;;
  -h|--help|help|"") usage; [ -n "$SUB" ]; exit $? ;;
  *) echo "bounded: unknown subcommand '$SUB'" >&2; echo >&2; usage >&2; exit 64 ;;
esac
