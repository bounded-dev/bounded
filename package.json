{
  "name": "bounded-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "src",
    "src/lib/*",
    "src/hosts/*",
    "src/cli",
    "src/published-packs/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:prereqs-status-band": "bun scripts/check-prereqs-status-band.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/picomatch": "4.0.3",
    "ajv": "8.20.0",
    "marked": "18.1.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "5.9.3"
  }
}
