#!/usr/bin/env bash
# bounded gates — run one artifact gate from any shell (ADR 2026-034).
#
#   bounded gates                          # list the gates
#   bounded gates red-gate                 # run a gate in the current project
#   bounded gates typecheck ../proj --json # against another directory, as JSON
#   bounded gates sign-off --help          # a gate's flags
#
# Why this exists: the gates were always host-independent — plain functions
# over the tree — but the only way to run them together was a pi session, so
# CI, a person at a shell, and any other agent had no front door. The CLI
# behind this is src/gates-cli.ts; it discovers every packs/<lang>/gates.ts
# and names no technology.
#
# Exit 0 PASS · 1 BLOCK · 2 ERROR (the gate could not run) · 3 RUNNING · 64 usage.
# RUNNING: a long gate under a host's command time limit is still working in
# the background; run the same gate again to collect it (ADR 2026-073).
#
# This runs the gate and nothing else: WHO may run it is the host's job (the
# path gate, in pi). From a bare shell every gate is runnable.

set -euo pipefail

# Lives in agent/scripts/, not agent/bin/ — `bin/` is gitignored as pi's own
# runtime directory, so a launcher there is silently untracked.
#
# Resolve this script's real location so the harness is found whether it was
# reached directly or through the ~/.pi/agent symlink.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
HARNESS="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

CLI="$HARNESS/src/gates-cli.ts"
if [ ! -f "$CLI" ]; then
  echo "bounded gates: cannot find the gates CLI at $CLI" >&2
  exit 2
fi

exec node "$CLI" "$@"
