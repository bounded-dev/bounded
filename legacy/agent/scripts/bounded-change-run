#!/usr/bin/env bash
# bounded change-run — open the run boundary for a CHANGE run on a delivered tree
# (ADR LEG-2026-028).
#
#   bounded change-run [targetDir]
#   bounded change-run --force [targetDir]     boundary even though the last run
#                                         never delivered (abandoning it)
#
# The developer stage keeps two kinds of state under `.bounded/`:
#
#   · TREE state — the contract manifest, the role binding, the model tiers.
#     These describe the project and survive across runs.
#   · RUN state — the guard log. Review freshness, the phase gate's spawn
#     preconditions, green-requires-red and the timing block are all derived
#     from it, so the log IS the run.
#
# A change run is a NEW run against the same tree, and this script draws that
# boundary the only way the gates understand: it archives the guard log. With
# a fresh log and a surviving manifest, every existing gate then forces the
# change sequence in order — design_gate takes its re-freeze path and blocks
# first on a MISSING review (the changed design must be re-challenged), the
# phase gate refuses worker spawns until that re-freeze passes, and green_gate
# finds no standing red, so a fresh shadow red over the revised tests is
# mandatory. No gate needed new logic; the boundary re-arms them all.
#
# Run by the DRIVER (a human, or the team lead one day), from outside the
# session, before launching the architect on the change request — the same
# place role binding happens, and for the same reason: a run cannot be allowed
# to redraw its own boundary. Nothing inside the session can call this.
#
# It refuses to draw a boundary through a LIVE run: if the current log holds
# no final successful `deliver` summary, the last run never finished. Rotating
# its log would void a standing red and orphan its review mid-flight.
# Re-entering a live run after an interruption is a RESUME (`pi -c`), not a
# boundary — that path needs the log intact. `--force` overrides when a run is
# abandoned, and marks the ticket the abandoned log names with
# `.bounded/tickets/<n>/abandoned`, so no later ticket takes a contract from it
# (ADR LEG-2026-071). A delivered boundary clears the marker of the ticket its log
# names, and none when it names no ticket.
set -euo pipefail

FORCE=0
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    -*) echo "bounded change-run: unknown flag '$arg'" >&2; exit 2 ;;
    *) TARGET="$arg" ;;
  esac
done
TARGET="${TARGET:-$PWD}"
[ -d "$TARGET" ] || { echo "bounded change-run: '$TARGET' is not a directory" >&2; exit 2; }

MANIFEST_REL=".bounded/contract-checksums.json"
if [ -f "$TARGET/docs/tn/README.md" ]; then
  TICKET="${BOUNDED_TICKET:-}"
  # Same selection as src/ticket-design.ts: BOUNDED_TICKET wins; else the
  # lead's selection file, in a project-local installation only.
  if [ -z "$TICKET" ] && [ -f "$TARGET/.bounded/installation.json" ] &&
     [ -f "$TARGET/.bounded/active-ticket" ] && [ ! -L "$TARGET/.bounded/active-ticket" ]; then
    TICKET="$(tr -d '[:space:]' < "$TARGET/.bounded/active-ticket")"
  fi
  if [[ ! "$TICKET" =~ ^[1-9][0-9]*$ ]]; then
    echo "bounded change-run: no active ticket — select the current issue with the team lead or set BOUNDED_TICKET" >&2
    exit 2
  fi
  MANIFEST_REL=".bounded/tickets/$TICKET/contract-checksums.json"
fi
MANIFEST="$TARGET/$MANIFEST_REL"
LOG="$TARGET/.bounded/guard-log.jsonl"

# A change run re-enters a tree the stage has delivered before. No manifest
# means no frozen design to change: that is a FIRST run, which needs no
# boundary — just launch it.
if [ ! -f "$MANIFEST" ]; then
  echo "bounded change-run: no frozen manifest at $MANIFEST_REL — this tree has" >&2
  echo "  never been through the developer stage, so there is no run to close. A first" >&2
  echo "  run needs no boundary: launch the architect directly." >&2
  exit 2
fi

if [ -f "$LOG" ]; then
  STATUS_SCRIPT="$(dirname "$0")/../src/change-run-status.ts"
  if ! DELIVERY_STATE="$(node "$STATUS_SCRIPT" "$LOG")"; then
    exit 1
  fi
  # The ticket the run worked on, as its log records it (ADR LEG-2026-071).
  if ! RUN_TICKET="$(node "$STATUS_SCRIPT" --ticket "$LOG")"; then
    exit 1
  fi
  if [ "$DELIVERY_STATE" = "malformed" ]; then
    echo "bounded change-run: malformed guard log; refusing to rotate it" >&2
    exit 1
  fi
  if [ "$DELIVERY_STATE" = "delivered" ]; then
    # A ticket abandoned earlier and now delivered may be taken from again.
    # Never fall back to the selected ticket: it may not be the one delivered.
    if [ -n "$RUN_TICKET" ]; then
      rm -f "$TARGET/.bounded/tickets/$RUN_TICKET/abandoned"
    else
      echo "bounded change-run: the delivered run names no ticket, so no abandoned marker is cleared"
    fi
    # Snapshot the last delivered design before the run record rotates.
    bash "$(dirname "$0")/bounded" capture-baseline --cwd "$TARGET"
  elif [ "$DELIVERY_STATE" = "undelivered" ]; then
    if [ "$FORCE" -ne 1 ]; then
      echo "bounded change-run: the current guard log holds no final successful delivery — the last run never" >&2
      echo "  finished. Rotating its log now would void its standing red and orphan its" >&2
      echo "  review mid-flight. To CONTINUE that run, resume the session (pi -c) instead;" >&2
      echo "  to ABANDON it and start a change run anyway, re-run with --force." >&2
      exit 1
    fi
    echo "bounded change-run: --force — abandoning an undelivered run"
  else
    echo "bounded change-run: unrecognized delivery state; refusing to rotate the guard log" >&2
    exit 1
  fi
  ARCHIVE_DIR="$TARGET/.bounded/guard-log-archive"
  mkdir -p "$ARCHIVE_DIR"
  STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
  mv "$LOG" "$ARCHIVE_DIR/guard-log-$STAMP.jsonl"
  echo "bounded change-run: archived the run log to .bounded/guard-log-archive/guard-log-$STAMP.jsonl"
  if [ "$DELIVERY_STATE" = "undelivered" ]; then
    # Mark the abandoned run's ticket so no later ticket takes a contract from
    # it (ADR LEG-2026-071). Never fall back to the selected ticket: it may be the
    # next ticket, not the abandoned one.
    if [ -n "$RUN_TICKET" ]; then
      mkdir -p "$TARGET/.bounded/tickets/$RUN_TICKET"
      printf '{"archive":"guard-log-%s.jsonl","at":"%s"}\n' "$STAMP" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "$TARGET/.bounded/tickets/$RUN_TICKET/abandoned"
      echo "bounded change-run: marked ticket #$RUN_TICKET abandoned (.bounded/tickets/$RUN_TICKET/abandoned)"
    else
      echo "bounded change-run: the abandoned run names no ticket, so no ticket is marked abandoned"
    fi
  fi
else
  echo "bounded change-run: no guard log to archive — already at a boundary"
fi

# The shadow is run state too: deliver removes it, but an abandoned run may
# have left one, and a red proven for the OLD design must not be lying around
# looking like evidence for the new one.
if [ -d "$TARGET/.bounded/shadow-red" ]; then
  rm -rf "$TARGET/.bounded/shadow-red"
  echo "bounded change-run: removed the previous run's .bounded/shadow-red"
fi

cat <<EOF
bounded change-run: boundary open — the tree keeps its manifest, role and tiers.
  Launch the architect with the change request. design_gate will take its
  re-freeze path: a fresh review first, then re-freeze (worker-owned drift
  from the contract edit does not block it), then the loop as normal.
EOF
