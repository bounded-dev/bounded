#!/usr/bin/env bash
# bounded-init — make a freshly cloned Bounded Harness live on this machine.
#
#   git clone git@github.com:bounded-dev/the-bounded-harness.git
#   cd the-bounded-harness && agent/scripts/bounded-init
#
# Does everything the README used to ask you to do by hand:
#
#   1. every host adapter's machine-level install (`hosts/<host>/install`) —
#      the core stays agnostic; each adapter wires its own framework
#   2. npm ci, then the harness's own test suite
#
# Idempotent: safe to re-run after a pull, and re-running is how you pick up a
# newly added command or adapter. It never overwrites a real file — only its
# own symlinks, and it says so when it finds something in the way.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
AGENT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
REPO="$(cd -P "$AGENT/.." && pwd)"

. "$AGENT/scripts/lib/install-helpers.sh"

echo "bounded machine bootstrap: $REPO"
echo
echo "Host adapters"
# Each adapter wires its own framework; the core only walks the roster.
for inst in "$AGENT"/hosts/*/install; do
  [ -f "$inst" ] || continue
  chmod +x "$inst"
  echo "  $(basename "$(dirname "$inst")"):"
  "$inst" | sed 's/^/  /'
done

echo
echo "Dependencies"
if [ -d "$AGENT/node_modules" ]; then
  ok "node_modules present (npm ci to refresh)"
else
  ( cd "$AGENT" && npm ci --silent >/dev/null 2>&1 ) && ok "npm ci" || warn "npm ci failed"
fi

echo
echo "Self-check"
if ( cd "$AGENT" && npm run check >/tmp/bounded-init-check.log 2>&1 ); then
  ok "$(grep -oE '[0-9]+ passed \([0-9]+\)' /tmp/bounded-init-check.log | tail -1) — harness is green"
else
  warn "npm run check FAILED — see /tmp/bounded-init-check.log"
  exit 1
fi

cat <<EOF

Ready. Publish the CLI from this checkout with:

  cd agent && npm run publish:local

For repository development, use:

  agent/scripts/bounded ticket        start a pi session as the architect
  agent/scripts/bounded gates --list  list available artifact gates
  scripts/dogfood/reset              rebuild the dogfood arms

Re-run \`agent/scripts/bounded-init\` after a pull.
EOF
