#!/usr/bin/env bash
# bounded ticket — start a pi session bound to the ARCHITECT role, for driving one
# ticket through the developer stage.
#
# Why this exists (issue #12): the path gate learns its role from WHICH
# extension file the session loads, and that is decided at launch, from outside
# the project — nothing inside the session can reach it, so an agent cannot
# choose or change its own role. Subagents get this for free (the parent passes
# the loader when it spawns them). A session YOU start does not, unless it is
# started this way.
#
# The alternative was a `.bounded/dev-stage-role` marker file inside the project,
# which is a strictly weaker trust class: it lives where the agents work, and a
# checkout could restore a different one. This keeps one mechanism for every
# role in the pipeline.
#
# Without a launcher nobody would type the full invocation, the ungated path
# would win by being easier, and the enforcement would quietly become optional.
#
#   bounded ticket                 # the ticket the team lead selected
#                                  # (.bounded/active-ticket), or a legacy project
#   bounded ticket --ticket 24     # explicit override (sets BOUNDED_TICKET)
#   bounded ticket "build X"       # with an opening prompt
#   bounded ticket --model …       # any further pi flags pass straight through
#
# Being gated means: read anything in the project, write only the ticket's
# design note and the contracts it owns, no bash, and the gates + git as named tools. The forbidden
# tools are not merely refused — they are absent from the toolset.

set -euo pipefail

if [ "${1:-}" = "--ticket" ]; then
  if [[ ! "${2:-}" =~ ^[1-9][0-9]*$ ]]; then
    echo "bounded ticket: --ticket needs a positive issue number" >&2
    exit 2
  fi
  export BOUNDED_TICKET="$2"
  shift 2
fi
# Same selection as src/ticket-design.ts: a nonempty BOUNDED_TICKET wins; else
# the team lead's .bounded/active-ticket, in a project-local installation only.
if [ -f "docs/tn/README.md" ]; then
  TICKET="${BOUNDED_TICKET:-}"
  if [ -z "$TICKET" ] && [ -f ".bounded/installation.json" ] &&
     [ -f ".bounded/active-ticket" ] && [ ! -L ".bounded/active-ticket" ]; then
    TICKET="$(tr -d '[:space:]' < ".bounded/active-ticket")"
  fi
  if [[ ! "$TICKET" =~ ^[1-9][0-9]*$ ]]; then
    echo "bounded ticket: no active ticket — select the current issue with the team lead (it records" >&2
    echo "  .bounded/active-ticket) or launch with --ticket <issue-number>" >&2
    exit 2
  fi
fi

# Lives in agent/scripts/, not agent/bin/ — `bin/` is gitignored as pi's own
# runtime directory, so a launcher there is silently untracked.
#
# Resolve this script's real location so the harness is found whether it was
# reached directly or through the ~/.pi/agent symlink.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
HARNESS="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

GATE="$HARNESS/hosts/pi/extensions/path-gate/architect.ts"
if [ ! -f "$GATE" ]; then
  echo "bounded ticket: cannot find the architect path-gate loader at $GATE" >&2
  exit 2
fi

# Drop the architect's forbidden tools from the toolset rather than relying on
# the gate to refuse them.
#
# The path gate DOES block these for the architect, but a blocked call is a
# wasted turn — and worse, a model that can SEE a tool in its toolset plans
# around it and reaches for it when stuck. A live session spent six consecutive
# turns on `bash` alone, plus one each on `run_tests` and the rest. A subagent
# never has this problem: its frontmatter `tools:` list removes the tool before
# the model ever sees it.
#
# The path-gate extension now strips these at `session_start` too, so this flag
# is no longer the only layer — but it is the STRONGER one: `--exclude-tools`
# drops the tool from the session's registry entirely, where the extension's
# `setActiveTools` only deactivates it. Keep both; keep this list equal to
# FORBIDDEN_TOOLS.architect in src/path-policy.ts (pinned by
# src/path-gate-tool-strip.test.ts).
exec pi --extension "$GATE" --exclude-tools bash,change_diff,run_tests,record_design_review "$@"
