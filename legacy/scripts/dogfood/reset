#!/usr/bin/env bash
# dogfood-reset — rebuild the two dogfood arms from scratch, ready to run.
#
#   scripts/dogfood/reset                     # both arms, the default prompt
#   scripts/dogfood/reset --harnessed         # ONLY the harnessed arm
#   scripts/dogfood/reset --bare              # ONLY the bare arm
#   scripts/dogfood/reset <prompt-file>       # any other prompt
#   scripts/dogfood/reset --init claude-code --harnessed docs/dogfood/pm-notes-prompt.md
#                                             # arm 1 from bounded init, whole stack
#
#   scripts/dogfood/reset --design-model <pattern>   # the judgment seats' model
#   scripts/dogfood/reset --worker-model <pattern>   # the production seats' model
#   scripts/dogfood/reset --smoke-models             # opt in to a paid deployment probe
#
# The two model flags set the harnessed arm's per-project model tiers (issue
# #13): `designModel` is what the architect and the reviewer run on,
# `workerModel` what the test-writer and the builder run on. A <pattern> is
# pi's model pattern and carries the thinking level with it, so one string
# sets both — `anthropic/claude-opus-4:high`, `fireworks/kimi-k3-fast:medium`.
# Either flag may be given alone; whichever is omitted leaves that tier on the
# session default. Both are written to `.bounded/dev-stage-models.json` in the
# harnessed arm and echoed in the summary, so the run's configuration is
# visible rather than remembered. Registry membership is checked before reset;
# it does not prove deployment. --smoke-models additionally makes one short paid
# request per distinct tier, before either arm is touched. They do nothing for the
# bare arm, which has no pipeline seats to tier.
#
# Reset one arm when the other is mid-run: a run dies for one-sided reasons
# (wrong model, a broken skill) far more often than for both at once, and
# wiping a healthy arm to restart a dead one throws away good data.
#
# Afterwards there is nothing to configure and no command to remember:
#
#   cd ~/dev/bounded-harness-dogfood-2   → arm 2 (default path; DOGFOOD_2 overrides)
#   cd ~/dev/bounded-harness-dogfood-1   → arm 1 (default path; DOGFOOD_1 overrides)
#   …and paste the canonical prompt from docs/dogfood/ into either.
#
# The harnessed arm binds the architect role itself through
# `.bounded/dev-stage-role`, so plain `pi` is gated — read anything, write only
# spec.md and *.contract.ts, no bash. Nothing to launch specially, and no
# per-arm tool config: the path-gate extension REMOVES the architect's
# forbidden tools from the session's toolset at session start, so the arm
# gets the same "the tool was never there" property a subagent gets from its
# frontmatter allowlist. (pi has no settings key for this — `defaultTools`
# covers built-in tools only and leaves extension tools enabled — which is
# why it is done in the extension rather than written into the arm's `.bounded/`.)
#
# Both arms get an identical operational AGENTS.md. The prompt lives ONLY in
# docs/dogfood/ — the arms carry no copy, so there is nothing to drift and
# nothing a reset can resurrect. Exactly one line differs between the arms,
# naming what that environment offers; that line is the whole experiment.
#
# Runs are DISPOSABLE, but never lost: an arm holding output is auto-archived
# to the run archive (branch `auto/<arm>-<timestamp>`) before it is wiped.
# Rename that branch later if the run turns out to be worth naming.

set -euo pipefail

# Overridable so the script can be exercised without destroying a live run.
# The two arm directories carry neutral names — dogfood-1 and dogfood-2 — because
# both arms are often harnessed now (different hosts/models), so "bare"/"harnessed"
# on the tin misled which terminal was which. The internal slots keep their role
# names: HARNESSED (the gated, developer-stage arm) is dogfood-1; BARE (the
# ordinary-tools control by default) is dogfood-2. Override with DOGFOOD_1/2.
HARNESSED="${DOGFOOD_1:-${DOGFOOD_HARNESSED:-$HOME/dev/bounded-harness-dogfood-1}}"
BARE="${DOGFOOD_2:-${DOGFOOD_BARE:-$HOME/dev/bounded-harness-dogfood-2}}"

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/../.." && pwd)"
AGENT="$REPO/agent"
HARNESS="$AGENT"

WHICH=both
DESIGN_MODEL=""
WORKER_MODEL=""
SMOKE_MODELS=false
# Packs the harnessed arm composes beyond the implicit ts pack (TN-26-005:
# composition is per project). This script stays content-free: everything a
# composed pack needs at scaffold time — dependency pins, project-init
# scripts — is read from the pack's own contrib.json. No pack name or
# technology appears below; the pack list is the caller's input.
COMPOSE_PACKS=()
# --init <host>: the harnessed arm is not the flat scaffold below but an empty
# directory initialized by `bounded init --host <host>` with its default
# selection, the whole stack: the project-local harness, the generated root
# config, and the team lead as the entry. That is how a real project starts,
# and the only way to get the hexagonal monorepo the stack's gates expect.
INIT_HOST=""
ARGS=()
# An index walk rather than `for a in "$@"`: the model flags take a value, and
# a value-taking flag needs to consume the argument after it.
while [ $# -gt 0 ]; do
  case "$1" in
    --harnessed) WHICH=harnessed ;;
    --bare)      WHICH=bare ;;
    --both)      WHICH=both ;;
    --smoke-models) SMOKE_MODELS=true ;;
    --design-model)
      shift; [ $# -gt 0 ] || { echo "dogfood-reset: --design-model needs a pi model pattern" >&2; exit 2; }
      DESIGN_MODEL="$1" ;;
    --worker-model)
      shift; [ $# -gt 0 ] || { echo "dogfood-reset: --worker-model needs a pi model pattern" >&2; exit 2; }
      WORKER_MODEL="$1" ;;
    --compose)
      shift; [ $# -gt 0 ] || { echo "dogfood-reset: --compose needs a pack name (a directory under agent/packs/)" >&2; exit 2; }
      COMPOSE_PACKS+=("$1") ;;
    --init)
      shift; [ $# -gt 0 ] || { echo "dogfood-reset: --init needs a host (pi or claude-code)" >&2; exit 2; }
      INIT_HOST="$1" ;;
    *)           ARGS+=("$1") ;;
  esac
  shift
done

# Only the harnessed arm has seats to tier. Saying so beats a silent no-op.
if [ "$WHICH" = "bare" ] && { [ -n "$DESIGN_MODEL" ] || [ -n "$WORKER_MODEL" ]; }; then
  echo "dogfood-reset: --design-model/--worker-model apply to the harnessed arm only — ignored" >&2
fi

# Deployment failures must precede prompt rendering, archiving and arm deletion.
if [ "$SMOKE_MODELS" = true ]; then
  [ "$WHICH" != bare ] || { echo "dogfood-reset: --smoke-models requires a harnessed arm" >&2; exit 2; }
  echo "dogfood-reset: smoke-checking explicit model tiers (paid provider requests; 60s limit per tier)"
  node "$REPO/scripts/dogfood/model-smoke.mjs" "$DESIGN_MODEL" "$WORKER_MODEL"
fi

PROMPT_SRC="${ARGS[0]:-$REPO/docs/dogfood/subscription-billing-prompt.md}"
[ -f "$PROMPT_SRC" ] || { echo "dogfood-reset: no prompt at $PROMPT_SRC" >&2; exit 2; }

# Prompt files hold only the prompt (notes live in docs/dogfood/README.md), so
# the arms see the source text as is. Copy it ONCE, next to the source, and
# point both arms at that copy.
RENDERED_PROMPT="$(dirname "$PROMPT_SRC")/.rendered-$(basename "$PROMPT_SRC")"
cp "$PROMPT_SRC" "$RENDERED_PROMPT"

# The operational block is identical in both arms by construction: it is one
# string, written twice. An arm that quietly gained a different toolchain note
# or a different definition of done would confound the run silently.
read -r -d '' BLOCK <<'EOF' || true
# Working in this repo

## The project

A standalone TypeScript component. Nothing else depends on it yet, so the
public surface is yours to design.

- **Source** goes in `src/`, **tests** in `tests/`. Keep them separate.
- **Test runner:** vitest 4.1.11. **TypeScript:** 5.9.3, `strict`, plus
  `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` — the settings
  are in `tsconfig.json` and are not up for negotiation.
- **Commands:**
  - `npm run check` — `tsc --noEmit` then the full suite. This is the bar.
  - `npm test` — the suite alone.
- ESM, `NodeNext` resolution: intra-project imports need the `.js` extension
  (`import { x } from "./money.js"`) even though the file is `.ts`.
- Do not add dependencies. Everything needed is installed.
- Do not commit; leave your work in the working tree.

Done means `npm run check` passes: the suite is green **and** the project
typechecks.

## How work is done here
EOF

BARE_LINE='Nothing special. Build it with your ordinary tools, the way you think it
should be built.'
HARNESSED_LINE='This project is built through the **`developer-stage`** skill. Invoke it and
follow it.'

# A run is destroyed by the next reset, and "remember to archive first" is
# exactly the kind of instruction that gets skipped at 1am. So don't instruct:
# archive anything that looks like output, automatically, before wiping.
# Curate the branch name later; never lose the run.
autosave() {
  local dir="$1" arm="$2"
  [ -d "$dir" ] || return 0
  # Output = anything the agents wrote beyond the scaffolded baseline: a spec
  # or ticket note, or code in the flat layout or the monorepo's workspaces.
  if [ -f "$dir/spec.md" ] || [ -n "$(find "$dir/docs/tn" -name 'TN-*.md' 2>/dev/null | head -1)" ] \
    || [ -n "$(find "$dir/src" "$dir/tests" "$dir/contexts" "$dir/apps" -name '*.ts' -not -path '*/node_modules/*' 2>/dev/null | head -1)" ]; then
    local name="auto/${arm}-$(date -u +%Y%m%dT%H%M%SZ)"
    echo "dogfood-reset: $arm arm has output — archiving to '$name' before wiping"
    "$REPO/scripts/dogfood/archive" "$name" --arm "$arm" \
      -m "Auto-archived by dogfood-reset before wiping the $arm arm." \
      || echo "dogfood-reset: WARNING — archive failed; the arm was NOT wiped" >&2
  fi
}

# `.bounded/dev-stage-models.json` — the per-project model tiers the harness reads
# at every subagent spawn (agent/src/dev-stage-models.ts). A key that is not
# set is simply absent: the reader treats a missing key as "no override", and
# an empty string as a malformed value it warns about.
# A reset that writes a dead model pattern is a silent tier loss. r15's first
# kimi reviewer ran on the session default for the whole run, because the
# configured `kimi-k3:high` matched nothing in the registry: injection skipped,
# the spawn went ahead, and a judgment seat quietly ran on whatever the session
# happened to be. The spawn gate now refuses that (agent/src/phase-gate.ts) —
# but a run refused at its first commission is still a wasted reset, so the
# pattern is checked HERE, where it is written and where fixing it costs one
# flag.
#
# The check mirrors `patternIsKnown` (agent/src/model-tier.ts) rather than
# taking `pi --list-models`'s own answer, and the difference is the whole
# point: --list-models FUZZY-matches, so `kimi-k3` lists two fireworks models
# and looks fine, while the injector accepts only an exact `provider/id` or a
# bare id exactly one provider offers. This has to fail exactly where the run
# would, not merely where a search would.
#
# Never fatal on a missing toolchain: no `pi` on PATH means the check could not
# run, which is not evidence the pattern is bad.
model_pattern_resolves() {
  local pattern="$1" base rows
  # Strip a known thinking suffix (pi's own levels) before looking it up: the
  # registry knows models, not how hard they think.
  base="$pattern"
  case "$pattern" in
    *:off|*:minimal|*:low|*:medium|*:high|*:xhigh|*:max) base="${pattern%:*}" ;;
  esac
  # Row 1 is the column header; "No models matching …" leaves nothing after it.
  rows="$(pi --list-models "$base" 2>/dev/null | tail -n +2)" || return 1
  [ -n "$rows" ] || return 1
  printf '%s\n' "$rows" | awk -v want="$base" '
    { if ($1 "/" $2 == want) exact++
      if ($2 == want) bare++ }
    END { exit (exact > 0 || bare == 1) ? 0 : 1 }
  '
}

# Refuse the reset rather than hand over an arm whose seats cannot be tiered.
check_model_pattern() {
  local flag="$1" pattern="$2"
  [ -n "$pattern" ] || return 0
  if ! command -v pi >/dev/null 2>&1; then
    echo "dogfood-reset: WARNING — no 'pi' on PATH, so $flag '$pattern' was not verified" >&2
    return 0
  fi
  if ! model_pattern_resolves "$pattern"; then
    echo "dogfood-reset: FATAL — $flag '$pattern' resolves to no model." >&2
    echo "  The harnessed arm would refuse to commission that seat, and without that" >&2
    echo "  refusal it would run on the session default with nothing saying so." >&2
    echo "  The value must be a full provider/id (a bare id works only when exactly" >&2
    echo "  one provider offers it), optionally with a thinking suffix:" >&2
    echo "      --design-model anthropic/claude-opus-4-6:high" >&2
    echo "  Candidates for '${pattern%:*}':" >&2
    pi --list-models "${pattern%:*}" 2>/dev/null | head -12 | sed 's/^/      /' >&2
    exit 1
  fi
}

# Model IDs must be valid before autosave or scaffold can touch either arm.
if [ "$WHICH" != bare ]; then
  check_model_pattern --design-model "$DESIGN_MODEL"
  check_model_pattern --worker-model "$WORKER_MODEL"
  if [ "$SMOKE_MODELS" = false ] && { [ -n "$DESIGN_MODEL" ] || [ -n "$WORKER_MODEL" ]; }; then
    echo "dogfood-reset: model deployment not checked; use --smoke-models to check deployment (paid requests)" >&2
  fi
fi

write_models_json() {
  local path="$1" design="$2" worker="$3" body=""
  if [ -n "$design" ]; then
    body="  \"designModel\": \"$design\""
  fi
  if [ -n "$worker" ]; then
    if [ -n "$body" ]; then body="$body,"$'\n'; fi
    body="$body  \"workerModel\": \"$worker\""
  fi
  printf '{\n%s\n}\n' "$body" > "$path"
}

scaffold() {
  local dir="$1" line="$2"
  local arm; case "$dir" in *harnessed*) arm=harnessed ;; *) arm=bare ;; esac
  autosave "$dir" "$arm" || return 1
  rm -rf "$dir"
  mkdir -p "$dir/src" "$dir/tests"

  # The blessed stacks are installed from birth (ADR 2026-029): zod backs
  # every value object's parse (ADR 2026-031) and @trpc/server backs any
  # service component, so "Do not add dependencies" stays true for the run.
  # Versions mirror the pack's own pins (agent/package.json).
  cat > "$dir/package.json" <<'EOF'
{
  "name": "dogfood",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
EOF

  # TSX is a first-class implementation extension (TN-26-006 A1): the scaffolder
  # emits a `.tsx` skeleton for a contract that declares a component, so the arm
  # must compile one from birth. `react-jsx` is the transform every blessed
  # frontend uses (no `import React` ceremony), and both halves are inert until
  # a `.tsx` file exists — an arm that never grows one typechecks exactly as it
  # did before. Setting it at reset rather than mid-run keeps the arms identical
  # and keeps tsconfig out of the run's own diff.
  cat > "$dir/tsconfig.json" <<'EOF'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
EOF

  printf '%s\n%s\n' "$BLOCK" "$line" > "$dir/AGENTS.md"
  # No PROMPT.md in the arms: the user pastes from the one canonical rendered
  # prompt in docs/dogfood/. A per-arm copy (or symlink) was one more thing to
  # keep identical, and deleting it here without deleting it there meant every
  # reset resurrected it.
  # `.bounded/` from birth: a run leaves a guard log and red_gate's shadow project
  # under it, and an archive that committed either would be carrying a copy of
  # the tests plus the harness's own bookkeeping into the record.
  # `scratch/` from birth too: the architect's sanctioned throwaway zone
  # (src/path-policy.ts) — a type-probe it may write but nothing scaffolds,
  # freezes, or ships. Gitignored so a stray probe is absent from the record.
  printf 'node_modules/\n.bounded/\nscratch/\n' > "$dir/.gitignore"
  touch "$dir/src/.gitkeep" "$dir/tests/.gitkeep"

  ( cd "$dir" && npm install --silent >/dev/null 2>&1 )
  ( cd "$dir" && git init -q && git add -A \
      && git commit -q -m "Baseline: empty TypeScript project + prompt" )
}

# A skill whose frontmatter will not parse does not error — it vanishes from
# the session's skill list, and the agent improvises the pipeline from memory.
# That voided a live arm on 2026-09-02. Check before handing over two arms.
if [ "$WHICH" != "bare" ]; then
  if ! ( cd "$AGENT" && npx vitest run src/skill-frontmatter.test.ts >/dev/null 2>&1 ); then
    echo "dogfood-reset: FATAL — a skill's frontmatter is malformed, so pi will" >&2
    echo "  silently drop it and the harnessed arm will run without its pipeline." >&2
    echo "  Run: cd $AGENT && npx vitest run src/skill-frontmatter.test.ts" >&2
    exit 1
  fi
fi

echo "dogfood-reset: rebuilding ${WHICH} from $PROMPT_SRC"
[ "$WHICH" = "harnessed" ] || scaffold "$BARE" "$BARE_LINE"
# Compose a pack into an arm: install its pinned dependencies and run its
# project-init scripts, all read from the pack's own manifest. The mechanism
# is this loop; the content is the pack's. A pack without a manifest, pins or
# scripts simply contributes nothing at scaffold time.
compose_pack() {
  local dir="$1" pack="$2"
  local manifest="$AGENT/packs/$pack/contrib.json"
  [ -f "$manifest" ] || { echo "dogfood-reset: FATAL — no manifest at packs/$pack/contrib.json" >&2; exit 1; }
  echo "dogfood-reset: composing pack '$pack' into the harnessed arm"
  local deps devs
  deps=$(python3 -c "import json,sys; d=json.load(open('$manifest')); p=d.get('pins',{}); print(' '.join(f'{k}@{v}' for k,v in p.get('dependencies',{}).items()))")
  devs=$(python3 -c "import json,sys; d=json.load(open('$manifest')); p=d.get('pins',{}); print(' '.join(f'{k}@{v}' for k,v in p.get('devDependencies',{}).items()))")
  if [ -n "$deps" ]; then ( cd "$dir" && npm install --save-exact --no-audit --no-fund $deps >/dev/null 2>&1 ) || { echo "dogfood-reset: FATAL — installing $pack pins failed" >&2; exit 1; }; fi
  if [ -n "$devs" ]; then ( cd "$dir" && npm install --save-dev --save-exact --no-audit --no-fund $devs >/dev/null 2>&1 ) || { echo "dogfood-reset: FATAL — installing $pack dev pins failed" >&2; exit 1; }; fi
  local scripts
  scripts=$(python3 -c "import json; d=json.load(open('$manifest')); print('\n'.join(d.get('projectInitScripts',[])))")
  local s
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    node --experimental-strip-types "$AGENT/packs/$pack/$s" "$dir"       || { echo "dogfood-reset: FATAL — $pack init script '$s' failed" >&2; exit 1; }
  done <<< "$scripts"
}

# The initialized arm: plan with bounded init, apply exactly the reviewed
# digest, commit the baseline. Nothing else is written into it — no role
# binding, no operational block — because the initialized project's own
# AGENTS.md (and CLAUDE.md) make the host session the team lead.
init_arm() {
  local dir="$1" host="$2" plan digest
  autosave "$dir" harnessed || return 1
  rm -rf "$dir"
  mkdir -p "$dir"
  ( cd "$dir" && git init -q )
  plan="$(node "$AGENT/src/project-init-cli.ts" --cwd "$dir" --host "$host")" \
    || { echo "dogfood-reset: FATAL — bounded init could not plan the arm" >&2; exit 1; }
  digest="$(printf '%s' "$plan" | python3 -c 'import json,sys; print(json.load(sys.stdin)["digest"])')"
  node "$AGENT/src/project-init-cli.ts" --cwd "$dir" --host "$host" --apply "$digest" >/dev/null \
    || { echo "dogfood-reset: FATAL — bounded init could not apply its own plan" >&2; exit 1; }
  ( cd "$dir" && git add -A && git commit -q -m "Baseline: bounded init --host $host (default selection)" )
  echo "dogfood-reset: initialized the harnessed arm with bounded init --host $host"
}

if [ "$WHICH" != "bare" ] && [ -n "$INIT_HOST" ]; then
  [ ${#COMPOSE_PACKS[@]} -eq 0 ] || { echo "dogfood-reset: --init composes the whole stack; drop --compose" >&2; exit 2; }
  init_arm "$HARNESSED" "$INIT_HOST"
  # Runtime state under .bounded/ is ignored by the initialized project, so
  # the tiers are written but not committed.
  if [ -n "$DESIGN_MODEL" ] || [ -n "$WORKER_MODEL" ]; then
    write_models_json "$HARNESSED/.bounded/dev-stage-models.json" "$DESIGN_MODEL" "$WORKER_MODEL"
  fi
elif [ "$WHICH" != "bare" ]; then
  scaffold "$HARNESSED" "$HARNESSED_LINE"
  # Record every selection, including the base-only case, before pack init.
  bash "$AGENT/scripts/bounded" compose --cwd "$HARNESSED" ts "${COMPOSE_PACKS[@]}"
  if [ ${#COMPOSE_PACKS[@]} -gt 0 ]; then
    for PACK in "${COMPOSE_PACKS[@]}"; do compose_pack "$HARNESSED" "$PACK"; done
    ( cd "$HARNESSED" && git add -A && git commit -q -m "Compose packs: ${COMPOSE_PACKS[*]}" )
  fi
  # Only the harnessed arm is gated. The role is read from this file at session
  # start, so a plain `pi` in this directory IS the architect — no launcher, no
  # flag, nothing to remember — and the same read strips bash, run_tests and
  # record_design_review out of the toolset before the first turn.
  mkdir -p "$HARNESSED/.bounded"
  printf 'architect\n' > "$HARNESSED/.bounded/dev-stage-role"
  # The model tiers live beside the role, read from the same `.bounded/` at spawn
  # time. Written only when asked for: an absent file means every seat runs on
  # the session default, which is the pre-#13 behaviour and a valid arm.
  if [ -n "$DESIGN_MODEL" ] || [ -n "$WORKER_MODEL" ]; then
    write_models_json "$HARNESSED/.bounded/dev-stage-models.json" "$DESIGN_MODEL" "$WORKER_MODEL"
  fi
  ( cd "$HARNESSED" && git add -A && git commit -q --amend --no-edit )
fi

# Guard the property the comparison rests on. The prompt lives only in
# docs/dogfood/ now — the arms carry no copy, so prompt identity is structural.
# Verify the canonical rendered prompt exists and is non-empty, since pasting
# from a missing file hands an arm nothing at all.
[ -s "$RENDERED_PROMPT" ] || { echo "dogfood-reset: FATAL — $RENDERED_PROMPT missing or empty" >&2; exit 1; }
# An initialized arm carries bounded init's own instructions, not the shared
# operational block, so there is nothing to compare it against.
if [ -z "$INIT_HOST" ] && [ -d "$BARE" ] && [ -d "$HARNESSED" ]; then
  if ! diff -q <(sed '/^## How work is done here$/q' "$BARE/AGENTS.md") \
               <(sed '/^## How work is done here$/q' "$HARNESSED/AGENTS.md") >/dev/null; then
    echo "dogfood-reset: FATAL — operational blocks differ between arms" >&2; exit 1
  fi
fi

# The tier pair is reported every time, set or not: "which models did that run
# use" is the first question asked of a timing result, and an unstated default
# is the answer nobody can reconstruct a week later.
MODEL_SUMMARY="  Model tiers (harnessed arm):
      designModel (architect, reviewer)   ${DESIGN_MODEL:-<session default>}
      workerModel (test-writer, builder)  ${WORKER_MODEL:-<session default>}"

if [ -n "$INIT_HOST" ]; then
  ARM1_NOTE="arm 1 — initialized by bounded init for $INIT_HOST, whole stack.
              Launch $INIT_HOST there: the session is the team lead. After
              the run, judge its structure against the conventions:
              node $REPO/scripts/dogfood/structure-compare.ts --conventions $HARNESSED
              (for the worked example's own product, also compare with it:
              BOUNDED_EXAMPLE_PROJECT=<example> node $REPO/scripts/dogfood/structure-compare.ts $HARNESSED)"
  READY="Arms ready."
else
  ARM1_NOTE="arm 1 — gated as the architect automatically (bash, run_tests and
              record_design_review are absent from the toolset, not just
              refused). Launch the host you intend for this arm."
  READY="Both arms ready. Operational blocks verified identical."
fi

cat <<EOF

$READY

  cd $HARNESSED
      $ARM1_NOTE
  cd $BARE
      arm 2 — the second arm. By default the ordinary-tools control; for a
              two-harnessed comparison it is set up as a gated arm too.

$MODEL_SUMMARY

  Paste the prompt from: $RENDERED_PROMPT

Runs are disposable — re-run scripts/dogfood/reset to start over.
EOF
