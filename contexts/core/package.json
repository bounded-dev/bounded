{
  "name": "bounded",
  "version": "3.0.0",
  "description": "Bounded: typed packs and extension points that guard what an AI coding agent may do, with the path gate pack, host-neutral events, verdicts and a guard log",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounded-dev/the-bounded-harness.git",
    "directory": "contexts/core"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/{adapters,composition-root,domain,packs}/**/*.test-support.ts",
    "!src/application/{composition,guard-log,lifecycle,project-config}/**/*.test-support.ts",
    "!src/application/project-setup/**/*{-source,-files}.test-support.ts",
    "!src/**/fixtures/**"
  ],
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "picomatch": "4.0.7",
    "zod": "4.6.4"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./testing/host-installer-conformance": "./src/application/project-setup/init-project/init-project.host-installer.test-support.ts",
    "./adapters/in-memory": "./src/adapters/out/in-memory/index.ts",
    "./adapters/file-system": "./src/adapters/out/file-system/index.ts",
    "./adapters/system": "./src/adapters/out/system/index.ts",
    "./open-project": "./src/composition-root/open-project.ts",
    "./path-gate": "./src/packs/path-gate/index.ts",
    "./path-gate/adapters/file-system": "./src/packs/path-gate/adapters/out/file-system/index.ts",
    "./path-gate/adapters/in-memory": "./src/packs/path-gate/adapters/out/in-memory/index.ts",
    "./path-gate/adapters/tree-sitter": "./src/packs/path-gate/adapters/out/tree-sitter/index.ts"
  },
  "type": "module"
}
